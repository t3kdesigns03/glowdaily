# GlowDaily — environment variables
# These are SERVER-ONLY and belong in Netlify → Site configuration → Environment
# variables. NEVER commit real values, and never prefix them so they reach the
# browser. The static pages call the function at /.netlify/functions/create-square-payment;
# only the function (server-side) sees these.

# ─── Square payments (the "Pay with Square" button) ──────────────────────────
# Until BOTH of the first two are set, the site falls back to the manual
# "we'll text you a Square link" note — nothing breaks.
#
# Where to get them: Square Developer Dashboard (developer.squareup.com) →
# your application → Credentials (Access token) and Locations (Location ID).
# Use the SANDBOX credentials first to test, then swap to PRODUCTION.

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" (default) while testing, "production" when going live.
SQUARE_ENVIRONMENT=sandbox
# Optional — pin the Square API version. Defaults to a known-good value in code.
# SQUARE_API_VERSION=2025-01-23
